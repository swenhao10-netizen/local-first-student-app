<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/felt_board" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="知行毛毡板" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <FrameLayout android:id="@+id/felt_open" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="53" />
        <FrameLayout android:id="@+id/felt_flip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="47" />
    </LinearLayout>
</FrameLayout>
